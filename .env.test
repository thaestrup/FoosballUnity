# Pinned for the Vitest run so MSW handlers (which hardcode http://localhost:5050)
# match what api.ts reads from import.meta.env. Without this, a developer-local
# .env pointing at a different port (e.g. the prod compose's 5051) would break
# every test that exercises a network call. Vite auto-loads .env.test in test mode.
VITE_BACKEND_URL=http://localhost:5050
