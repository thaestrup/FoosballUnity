# Backend URL the React app calls.
# Dev: read at runtime by Vite. Prod: baked into the bundle at build time.
VITE_BACKEND_URL=http://localhost:5050

# Prod-only: host port nginx listens on (set via the nginx.conf template).
# Avoid 4200 (dev Vite) and 5050 (backend); 8080 is a safe default.
FRONTEND_PORT=8080
