exports[`RankingsList — snapshot > matches snapshot when empty 1`] = `
<div
  class="wrapper"
>
  <div
    class="tabs"
  >
    <button
      class="tab "
      type="button"
    >
      Last hour
    </button>
    <button
      class="tab "
      type="button"
    >
      Today
    </button>
    <button
      class="tab "
      type="button"
    >
      This week
    </button>
    <button
      class="tab "
      type="button"
    >
      This month
    </button>
    <button
      aria-current="true"
      class="tab active"
      type="button"
    >
      All time
    </button>
  </div>
  <p
    class="muted"
  >
    No ranked players in this period. Played games will appear here.
  </p>
  <section
    class="chartWrap"
  >
    <h3
      class="chartTitle"
    >
      Points over time — 
      2
       ready player
      s
    </h3>
    <div
      class="recharts-responsive-container"
      style="width: 100%; height: 280px; min-width: 0;"
    />
  </section>
</div>
`;

