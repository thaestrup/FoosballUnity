// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PlayerDetail — snapshot > matches snapshot for a player with a couple of stable games 1`] = `
<article
  class="wrapper"
>
  <header
    class="header"
  >
    <img
      alt=""
      class="avatar"
      decoding="async"
      loading="lazy"
      src="http://localhost:5050/players/Lars/photo?v=0"
    />
    <div
      class="titleBlock"
    >
      <h2
        class="name"
      >
        Lars
      </h2>
      <a
        class="backLink"
        href="/players"
      >
        ← All players
      </a>
    </div>
  </header>
  <div
    class="stats"
  >
    <div
      class="statCard "
    >
      <span
        class="statValue"
      >
        2
      </span>
      <span
        class="statLabel"
      >
        games
      </span>
    </div>
    <div
      class="statCard tone_win"
    >
      <span
        class="statValue"
      >
        1
      </span>
      <span
        class="statLabel"
      >
        won
      </span>
    </div>
    <div
      class="statCard tone_loss"
    >
      <span
        class="statValue"
      >
        1
      </span>
      <span
        class="statLabel"
      >
        lost
      </span>
    </div>
    <div
      class="statCard tone_tie"
    >
      <span
        class="statValue"
      >
        0
      </span>
      <span
        class="statLabel"
      >
        drew
      </span>
    </div>
    <div
      class="statCard "
    >
      <span
        class="statValue"
      >
        50%
      </span>
      <span
        class="statLabel"
      >
        win rate
      </span>
    </div>
  </div>
  <section
    class="chartSection"
  >
    <div
      data-testid="chart-placeholder"
    >
      [chart]
    </div>
  </section>
  <h3
    class="subhead"
  >
    Recent games
  </h3>
  <ol
    class="gamesList"
  >
    <li>
      <article
        class="gameRow row_win"
      >
        <span
          class="gameId"
        >
          #
          101
        </span>
        <time
          class="gameTime"
        >
          4/30/2026, 12:00:00 PM
        </time>
        <span
          class="partner"
        >
          w/ Joan
        </span>
        <span
          class="opponents"
        >
          vs 
          Frank & Daniel
        </span>
        <span
          class="outcome"
        >
          Won
        </span>
        <span
          class="gamePoints"
        >
          20
           pts
        </span>
      </article>
    </li>
    <li>
      <article
        class="gameRow row_loss"
      >
        <span
          class="gameId"
        >
          #
          102
        </span>
        <time
          class="gameTime"
        >
          4/30/2026, 1:00:00 PM
        </time>
        <span
          class="partner"
        >
          w/ Joan
        </span>
        <span
          class="opponents"
        >
          vs 
          Frank & Daniel
        </span>
        <span
          class="outcome"
        >
          Lost
        </span>
        <span
          class="gamePoints"
        >
          10
           pts
        </span>
      </article>
    </li>
  </ol>
</article>
`;
