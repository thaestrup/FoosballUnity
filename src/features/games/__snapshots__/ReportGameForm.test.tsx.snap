// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ReportGameForm > snapshots > matches snapshot in its default open state 1`] = `
<div>
  <form
    class="form"
    novalidate=""
  >
    <fieldset
      class="team"
    >
      <legend
        class="teamLegend"
        data-color="red"
      >
        Red team
      </legend>
      <select
        class="select"
        name="red1"
      >
        <option
          value=""
        >
          Pick a player…
        </option>
        <option
          value="Daniel"
        >
          Daniel
        </option>
        <option
          value="Frank"
        >
          Frank
        </option>
        <option
          value="Joan"
        >
          Joan
        </option>
        <option
          value="Lars"
        >
          Lars
        </option>
      </select>
      <select
        class="select"
        name="red2"
      >
        <option
          value=""
        >
          Pick a player…
        </option>
        <option
          value="Daniel"
        >
          Daniel
        </option>
        <option
          value="Frank"
        >
          Frank
        </option>
        <option
          value="Joan"
        >
          Joan
        </option>
        <option
          value="Lars"
        >
          Lars
        </option>
      </select>
    </fieldset>
    <fieldset
      class="team"
    >
      <legend
        class="teamLegend"
        data-color="blue"
      >
        Blue team
      </legend>
      <select
        class="select"
        name="blue1"
      >
        <option
          value=""
        >
          Pick a player…
        </option>
        <option
          value="Daniel"
        >
          Daniel
        </option>
        <option
          value="Frank"
        >
          Frank
        </option>
        <option
          value="Joan"
        >
          Joan
        </option>
        <option
          value="Lars"
        >
          Lars
        </option>
      </select>
      <select
        class="select"
        name="blue2"
      >
        <option
          value=""
        >
          Pick a player…
        </option>
        <option
          value="Daniel"
        >
          Daniel
        </option>
        <option
          value="Frank"
        >
          Frank
        </option>
        <option
          value="Joan"
        >
          Joan
        </option>
        <option
          value="Lars"
        >
          Lars
        </option>
      </select>
    </fieldset>
    <fieldset
      class="outcome"
    >
      <legend>
        Winner
      </legend>
      <label
        class="radio"
      >
        <input
          name="winner"
          type="radio"
          value="red"
        />
        Red
      </label>
      <label
        class="radio"
      >
        <input
          name="winner"
          type="radio"
          value="blue"
        />
        Blue
      </label>
      <label
        class="radio"
      >
        <input
          name="winner"
          type="radio"
          value="draw"
        />
        Tie
      </label>
    </fieldset>
    <div
      class="numbers"
    >
      <label
        class="numberField"
      >
        <span>
          Points
        </span>
        <input
          class="numberInput"
          max="99"
          min="0"
          name="points"
          type="number"
        />
      </label>
      <label
        class="numberField"
      >
        <span>
          Table
        </span>
        <input
          class="numberInput"
          max="99"
          min="1"
          name="table"
          type="number"
        />
      </label>
    </div>
    <div
      class="actions"
    >
      <button
        class="submit"
        type="submit"
      >
        Report game
      </button>
      <button
        class="cancel"
        type="button"
      >
        Cancel
      </button>
    </div>
  </form>
</div>
`;

