      </button>
      <button
        class="rowButton danger"
        type="button"
      >
        Delete
      </button>
    </div>
  </header>
  <div
    class="match"
  >
    <div
      class="team team_red outcome_loss"
    >
      <img
        alt=""
        class="avatar"
        decoding="async"
        loading="lazy"
        src="http://localhost:5050/players/Lars/photo?v=0"
      />
      <img
        alt=""
        class="avatar"
        decoding="async"
        loading="lazy"
        src="http://localhost:5050/players/Joan/photo?v=0"
      />
      <span
        class="teamLabel"
      >
        Lars & Joan
      </span>
      <span
        class="outcomeBadge"
      >
        Lost
      </span>
    </div>
    <span
      aria-hidden="true"
      class="versus"
    >
      vs
    </span>
    <div
      class="team team_blue outcome_win"
    >
      <img
        alt=""
        class="avatar"
        decoding="async"
        loading="lazy"
        src="http://localhost:5050/players/Frank/photo?v=0"
      />
      <img
        alt=""
        class="avatar"
        decoding="async"
        loading="lazy"
        src="http://localhost:5050/players/Daniel/photo?v=0"
      />
      <span
        class="teamLabel"
      >
        Frank & Daniel
      </span>
      <span
        class="outcomeBadge"
      >
        Won
      </span>
    </div>
  </div>
</article>
`;

