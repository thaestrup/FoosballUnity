exports[`GamesList > snapshots > GameCard loss outcome snapshot (blue wins) 1`] = `
<article
  class="card "
>
  <header
    class="cardHeader"
  >
    <span
      class="gameId"
    >
      #
      2
    </span>
    <time
      class="timestamp"
    >
