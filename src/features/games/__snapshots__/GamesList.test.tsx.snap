        <button
          aria-current="true"
          class="tab active"
          type="button"
        >
          This week
        </button>
        <button
          class="tab "
          type="button"
        >
          This month
        </button>
        <button
          class="tab "
          type="button"
        >
          All time
        </button>
      </div>
      <button
        class="clearAll"
        disabled=""
        type="button"
      >
        Clear all games
      </button>
    </div>
    <p
      class="muted"
    >
      No games in this period. Played games will appear here.
    </p>
    <button
      aria-label="Report game"
      class="fab"
      title="Report game"
      type="button"
    >
      +
    </button>
    <dialog
      aria-labelledby="_r_1v_"
      class="dialog"
    >
      <div
        class="content"
      >
        <header
          class="header"
        >
          <h2
            class="title"
            id="_r_1v_"
          >
            Report game
          </h2>
          <button
            aria-label="Close"
            class="close"
            type="button"
          >
            ×
          </button>
        </header>
        <div
          class="body"
        >
          <form
            class="form"
            novalidate=""
          >
            <fieldset
              class="team"
            >
              <legend
                class="teamLegend"
                data-color="red"
              >
                Red team
              </legend>
              <select
                class="select"
                name="red1"
              >
                <option
                  value=""
                >
                  Pick a player…
                </option>
                <option
                  value="Daniel"
                >
                  Daniel
                </option>
                <option
                  value="Frank"
                >
                  Frank
                </option>
                <option
                  value="Joan"
                >
                  Joan
                </option>
                <option
                  value="Lars"
                >
                  Lars
                </option>
              </select>
              <select
                class="select"
                name="red2"
              >
                <option
                  value=""
                >
                  Pick a player…
                </option>
                <option
                  value="Daniel"
                >
                  Daniel
                </option>
                <option
                  value="Frank"
                >
                  Frank
                </option>
                <option
                  value="Joan"
                >
                  Joan
                </option>
                <option
                  value="Lars"
                >
                  Lars
                </option>
              </select>
            </fieldset>
            <fieldset
              class="team"
            >
              <legend
                class="teamLegend"
                data-color="blue"
              >
                Blue team
              </legend>
              <select
                class="select"
                name="blue1"
              >
                <option
                  value=""
                >
                  Pick a player…
                </option>
                <option
                  value="Daniel"
                >
                  Daniel
                </option>
                <option
                  value="Frank"
                >
                  Frank
                </option>
                <option
                  value="Joan"
                >
                  Joan
                </option>
                <option
                  value="Lars"
                >
                  Lars
                </option>
              </select>
              <select
                class="select"
                name="blue2"
              >
                <option
                  value=""
                >
                  Pick a player…
                </option>
                <option
                  value="Daniel"
                >
                  Daniel
                </option>
                <option
                  value="Frank"
                >
                  Frank
                </option>
                <option
                  value="Joan"
                >
                  Joan
                </option>
                <option
                  value="Lars"
                >
                  Lars
                </option>
              </select>
            </fieldset>
            <fieldset
              class="outcome"
            >
              <legend>
                Winner
              </legend>
              <label
                class="radio"
              >
                <input
                  name="winner"
                  type="radio"
                  value="red"
                />
                Red
              </label>
              <label
                class="radio"
              >
                <input
                  name="winner"
                  type="radio"
                  value="blue"
                />
                Blue
              </label>
              <label
                class="radio"
              >
                <input
                  name="winner"
                  type="radio"
                  value="draw"
                />
                Tie
              </label>
            </fieldset>
            <div
              class="numbers"
            >
              <label
                class="numberField"
              >
                <span>
                  Points
                </span>
                <input
                  class="numberInput"
                  max="99"
                  min="0"
                  name="points"
                  type="number"
                />
              </label>
              <label
                class="numberField"
              >
                <span>
                  Table
                </span>
                <input
                  class="numberInput"
                  max="99"
                  min="1"
                  name="table"
                  type="number"
                />
              </label>
            </div>
            <div
              class="actions"
            >
              <button
                class="submit"
                type="submit"
              >
                Report game
              </button>
              <button
                class="cancel"
                type="button"
              >
                Cancel
              </button>
            </div>
          </form>
        </div>
      </div>
    </dialog>
    <dialog
      aria-labelledby="_r_20_"
      class="dialog"
    >
      <div
        class="content"
      >
        <header
          class="header"
        >
          <h2
            class="title"
            id="_r_20_"
          >
            Edit game
