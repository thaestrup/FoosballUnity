// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`route /tournament (Tournament) snapshot > matches snapshot in its initial "no rounds yet" state with pre-seeded queries 1`] = `
<div
  class="layout"
>
  <main
    class="main"
  >
    <p
      class="muted"
    >
      Use the controls to generate a set of pairings. Make sure the players you want to include are marked ready on
       
      <a
        class="link"
        href="/players"
      >
        the players page
      </a>
      .
    </p>
  </main>
  <aside
    class="sidebar"
  >
    <section
      class="timerSection"
    >
      <h3
        class="sectionTitle"
      >
        Match timer
      </h3>
      <div
        class="wrapper"
      >
        <div
          class="display normal "
        >
          <span
            class="time"
          >
            00:00
          </span>
          <span
            class="label"
          >
            ready
          </span>
        </div>
        <div
          class="controls"
        >
          <button
            class="primary"
            type="button"
          >
            Start / Reset
          </button>
          <label
            class="field"
          >
            <span>
              Duration
            </span>
            <select
              class="select"
            >
              <option
                value="30"
              >
                30
                 s
              </option>
              <option
                value="60"
              >
                60
                 s
              </option>
              <option
                value="120"
              >
                120
                 s
              </option>
            </select>
          </label>
        </div>
      </div>
    </section>
    <details
      class="accordion"
    >
      <summary
        class="summary"
      >
        Tournament options
      </summary>
      <div
        class="accordionBody"
      >
        <label
          class="field"
        >
          <span>
            Algorithm
          </span>
          <select
            class="select"
          >
            <option
              value="randomTournament"
            >
              Random
            </option>
            <option
              value="lastFirstTournament"
            >
              Last-first
            </option>
            <option
              value="awesomeAlgorithmTournament"
            >
              Awesome
            </option>
          </select>
        </label>
        <label
          class="field"
        >
          <span>
            Boards
          </span>
          <input
            class="numberInput"
            max="20"
            min="1"
            type="number"
            value="2"
          />
        </label>
        <label
          class="checkbox"
        >
          <input
            type="checkbox"
          />
          Allow uneven teams (solo)
        </label>
      </div>
    </details>
    <button
      class="generate"
      type="button"
    >
      Generate
    </button>
    <details
      class="accordion"
      open=""
    >
      <summary
        class="summary"
      >
        Rankings
      </summary>
      <div
        class="accordionBody"
      >
        <div
          class="wrapper"
        >
          <div
            class="tabs short"
          >
            <button
              class="tab "
              type="button"
            >
              Hr
            </button>
            <button
              class="tab "
              type="button"
            >
              Day
            </button>
            <button
              class="tab "
              type="button"
            >
              Wk
            </button>
            <button
              class="tab "
              type="button"
            >
              Mo
            </button>
            <button
              aria-current="true"
              class="tab active"
              type="button"
            >
              All
            </button>
          </div>
          <ol
            class="list"
          >
            <li>
              <a
                class="row"
                href="/player/Lars"
              >
                <span
                  class="medal gold"
                >
                  1
                </span>
                <img
                  alt=""
                  class="avatar"
                  decoding="async"
                  loading="lazy"
                  src="http://localhost:5050/players/Lars/photo?v=0"
                />
                <span
                  class="name"
                >
                  Lars
                </span>
                <span
                  class="points"
                >
                  1530
                </span>
              </a>
            </li>
            <li>
              <a
                class="row"
                href="/player/Joan"
              >
                <span
                  class="medal silver"
                >
                  2
                </span>
                <img
                  alt=""
                  class="avatar"
                  decoding="async"
                  loading="lazy"
                  src="http://localhost:5050/players/Joan/photo?v=0"
                />
                <span
                  class="name"
                >
                  Joan
                </span>
                <span
                  class="points"
                >
                  1510
                </span>
              </a>
            </li>
            <li>
              <a
                class="row"
                href="/player/Frank"
              >
                <span
                  class="medal bronze"
                >
                  3
                </span>
                <img
                  alt=""
                  class="avatar"
                  decoding="async"
                  loading="lazy"
                  src="http://localhost:5050/players/Frank/photo?v=0"
                />
                <span
                  class="name"
                >
                  Frank
                </span>
                <span
                  class="points"
                >
                  1490
                </span>
              </a>
            </li>
          </ol>
        </div>
      </div>
    </details>
  </aside>
</div>
`;
