// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`route /players (PlayersList) snapshot > matches snapshot with default mocked players and pinned lastPlayed 1`] = `
<div
  class="wrapper"
>
  <div
    class="toolbar"
  >
    <span
      class="count"
    >
      2
       / 
      4
       selected
    </span>
    <div
      class="toolbarActions"
    >
      <button
        class="toolbarButton"
        type="button"
      >
        Select all
      </button>
      <button
        class="toolbarButton"
        type="button"
      >
        Clear all
      </button>
    </div>
  </div>
  <ul
    class="list"
  >
    <li>
      <button
        aria-pressed="false"
        class="card"
        type="button"
      >
        <img
          alt=""
          class="avatar"
          decoding="async"
          loading="lazy"
          src="/img/daniel.jpg"
        />
        <span
          class="name"
        >
          Daniel
        </span>
      </button>
    </li>
    <li>
      <button
        aria-pressed="false"
        class="card"
        type="button"
      >
        <img
          alt=""
          class="avatar"
          decoding="async"
          loading="lazy"
          src="/img/frank.jpg"
        />
        <span
          class="name"
        >
          Frank
        </span>
      </button>
    </li>
    <li>
      <button
        aria-pressed="true"
        class="card selected"
        type="button"
      >
        <img
          alt=""
          class="avatar"
          decoding="async"
          loading="lazy"
          src="/img/joan.jpg"
        />
        <span
          class="name"
        >
          Joan
        </span>
        <span
          aria-label="selected"
          class="check"
        >
          ✓
        </span>
      </button>
    </li>
    <li>
      <button
        aria-pressed="true"
        class="card selected"
        type="button"
      >
        <img
          alt=""
          class="avatar"
          decoding="async"
          loading="lazy"
          src="/img/lars.jpg"
        />
        <span
          class="name"
        >
          Lars
        </span>
        <span
          aria-label="selected"
          class="check"
        >
          ✓
        </span>
      </button>
    </li>
  </ul>
  <button
    aria-label="Add player"
    class="fab"
    title="Add player"
    type="button"
  >
    +
  </button>
  <dialog
    class="dialog"
  >
    <div
      class="content"
    >
      <header
        class="header"
      >
        <h2
          class="title"
        >
          Add player
        </h2>
        <button
          aria-label="Close"
          class="close"
          type="button"
        >
          ×
        </button>
      </header>
      <div
        class="body"
      >
        <form
          class="form"
          novalidate=""
        >
          <input
            aria-invalid="false"
            class="input"
            name="name"
            placeholder="Player name"
            type="text"
          />
          <button
            class="submit"
            type="submit"
          >
            Add
          </button>
          <button
            class="cancel"
            type="button"
          >
            Cancel
          </button>
        </form>
      </div>
    </div>
  </dialog>
</div>
`;
